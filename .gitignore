# Dotfiles and dot-directories are local tool state (IDE settings, caches, sync
# snapshots) unless listed here.
.*
!.gitignore
!.github/

**/build/
**/.gradle/
**/.kotlin/
**/kotlin-js-store/
**/gradle-wrapper.jar
*.aab
*.apk

# Android SDK location and local API tokens (machine-specific, must not be committed)
local.properties

# Editor backup files (these can copy secrets such as local.properties)
*~
