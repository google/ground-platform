# Allowlist only the files the multi-stage server/Dockerfile build needs, so
# client apps, node_modules, build outputs, git history, and local secrets never
# enter the Docker build context.
*

!gradlew
!gradle.properties
!settings.gradle.kts
!build.gradle.kts
!gradle/
!build-logic/
!config/
!shared/
shared/*
!shared/protos/
!shared/core/
!server/

**/build/
**/.gradle/
**/.kotlin/
**/gradle-wrapper.jar
**/local.properties
**/*.key
**/*service-account*.json
