form_templates {
  id: "ferm_monitoring_wave"
  title {
    values {
      key: "en"
      value: "Restoration monitoring wave"
    }
    values {
      key: "fr"
      value: "Suivi de la restauration"
    }
    values {
      key: "es"
      value: "Monitoreo de restauración"
    }
  }
  description {
    values {
      key: "en"
      value: "Repeat visit recording restoration progress and tree survival."
    }
  }
  form {
    form_id: "ferm_monitoring_wave"
    title: "Restoration monitoring wave"
    version: "1"
    model {
      primary_instance {
        record_schema {
          name: "data"
          title: "Restoration monitoring wave"
          fields {
            name: "intervention_type"
            type: TYPE_SELECT_ONE
          }
          fields {
            name: "area_under_restoration_ha"
            type: TYPE_DOUBLE
          }
          fields {
            name: "start_date"
            type: TYPE_DATE
          }
          fields {
            name: "trees_planted"
            type: TYPE_INT32
          }
          fields {
            name: "trees_surviving"
            type: TYPE_INT32
          }
          fields {
            name: "site_photo"
            type: TYPE_BINARY
          }
        }
      }
      secondary_instances {
        id: "intervention_type"
        rows {
          fields {
            key: "name"
            value {
              scalar_value {
                string_value: "natural_regeneration"
              }
            }
          }
          fields {
            key: "label"
            value {
              scalar_value {
                string_value: "Natural regeneration"
              }
            }
          }
          fields {
            key: "ground_code"
            value {
              scalar_value {
                string_value: "natural_regeneration"
              }
            }
          }
        }
        rows {
          fields {
            key: "name"
            value {
              scalar_value {
                string_value: "assisted_natural_regeneration"
              }
            }
          }
          fields {
            key: "label"
            value {
              scalar_value {
                string_value: "Assisted natural regeneration"
              }
            }
          }
          fields {
            key: "ground_code"
            value {
              scalar_value {
                string_value: "assisted_natural_regeneration"
              }
            }
          }
        }
        rows {
          fields {
            key: "name"
            value {
              scalar_value {
                string_value: "tree_planting"
              }
            }
          }
          fields {
            key: "label"
            value {
              scalar_value {
                string_value: "Tree planting"
              }
            }
          }
          fields {
            key: "ground_code"
            value {
              scalar_value {
                string_value: "tree_planting"
              }
            }
          }
        }
        rows {
          fields {
            key: "name"
            value {
              scalar_value {
                string_value: "agroforestry"
              }
            }
          }
          fields {
            key: "label"
            value {
              scalar_value {
                string_value: "Agroforestry"
              }
            }
          }
          fields {
            key: "ground_code"
            value {
              scalar_value {
                string_value: "agroforestry"
              }
            }
          }
        }
        rows {
          fields {
            key: "name"
            value {
              scalar_value {
                string_value: "mangrove_restoration"
              }
            }
          }
          fields {
            key: "label"
            value {
              scalar_value {
                string_value: "Mangrove restoration"
              }
            }
          }
          fields {
            key: "ground_code"
            value {
              scalar_value {
                string_value: "mangrove_restoration"
              }
            }
          }
        }
        rows {
          fields {
            key: "name"
            value {
              scalar_value {
                string_value: "other"
              }
            }
          }
          fields {
            key: "label"
            value {
              scalar_value {
                string_value: "Other"
              }
            }
          }
          fields {
            key: "ground_code"
            value {
              scalar_value {
                string_value: "other"
              }
            }
          }
        }
      }
      bindings {
        field_path: "intervention_type"
        type: TYPE_SELECT_ONE
        required_expression: "true()"
        foreign_attributes {
          namespace_uri: "http://groundplatform.org/xforms"
          qualified_name: "ground:concept"
          value: "ferm.intervention_type@1"
        }
      }
      bindings {
        field_path: "area_under_restoration_ha"
        type: TYPE_DOUBLE
        foreign_attributes {
          namespace_uri: "http://groundplatform.org/xforms"
          qualified_name: "ground:concept"
          value: "ferm.area_under_restoration_ha@1"
        }
      }
      bindings {
        field_path: "start_date"
        type: TYPE_DATE
        foreign_attributes {
          namespace_uri: "http://groundplatform.org/xforms"
          qualified_name: "ground:concept"
          value: "ferm.start_date@1"
        }
      }
      bindings {
        field_path: "trees_planted"
        type: TYPE_INT32
        foreign_attributes {
          namespace_uri: "http://groundplatform.org/xforms"
          qualified_name: "ground:concept"
          value: "ferm.trees_planted@1"
        }
      }
      bindings {
        field_path: "trees_surviving"
        type: TYPE_INT32
        foreign_attributes {
          namespace_uri: "http://groundplatform.org/xforms"
          qualified_name: "ground:concept"
          value: "ferm.trees_surviving@1"
        }
      }
      bindings {
        field_path: "site_photo"
        type: TYPE_BINARY
        foreign_attributes {
          namespace_uri: "http://groundplatform.org/xforms"
          qualified_name: "ground:concept"
          value: "core.site_photo@1"
        }
      }
    }
    view {
      components {
        control {
          field_ref: "intervention_type"
          type: CONTROL_SELECT_ONE
          label {
            text: "Restoration intervention"
          }
          itemset {
            instance_id: "intervention_type"
            value_ref: "name"
            label_ref: "label"
            nodeset_path: "/root/item"
          }
        }
      }
      components {
        control {
          field_ref: "area_under_restoration_ha"
          type: CONTROL_INPUT
          label {
            text: "Area under restoration (ha)"
          }
        }
      }
      components {
        control {
          field_ref: "start_date"
          type: CONTROL_INPUT
          label {
            text: "Restoration start date"
          }
        }
      }
      components {
        control {
          field_ref: "trees_planted"
          type: CONTROL_INPUT
          label {
            text: "Trees planted"
          }
        }
      }
      components {
        control {
          field_ref: "trees_surviving"
          type: CONTROL_INPUT
          label {
            text: "Trees surviving"
          }
        }
      }
      components {
        control {
          field_ref: "site_photo"
          type: CONTROL_UPLOAD
          label {
            text: "Site photo"
          }
          media_type: "image/*"
        }
      }
    }
  }
  status: STABLE
}
