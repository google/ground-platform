  }
  keywords {
    values {
      key: "en"
      value: "ranger patrol"
    }
  }
  data_type: TYPE_DOUBLE
  unit: "km"
  aggregation: SUM
  privacy_class: AGGREGATE_PUBLIC
  goals: "effective_protected_areas"
