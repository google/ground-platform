# proto-file: shared/protos/library/library_bundle.proto
# proto-message: groundplatform.v2.library.LibraryBundle
#
# Global library seed: the `pame` vocabulary. Bootstraps the "All users"
# organization's library on a new deployment; entries omit organization_id,
# which the loader sets to the "All users" organization.
#
# The prototype app embeds a Kotlin copy (GlobalLibrarySeedData.kt), and its
# GlobalLibrarySeedTest fails when the two differ. Template questions don't
# carry concept links yet (FieldBinding has no concept_ref field).

concepts {
  id: "pame.threat_type"
  version: 1
  label {
    values {
      key: "en"
      value: "Threat type"
    }
  }
  description {
    values {
      key: "en"
      value: "Threats to the protected area observed at the site."
    }
  }
  keywords {
    values {
      key: "en"
      value: "pressure"
    }
  }
  keywords {
    values {
      key: "en"
      value: "disturbance"
    }
  }
  keywords {
    values {
      key: "es"
      value: "amenaza"
    }
  }
  data_type: TYPE_SELECT_MULTIPLE
  code_list {
    items {
      code: "logging"
      label {
        values {
          key: "en"
          value: "Logging"
        }
      }
    }
    items {
      code: "poaching"
      label {
        values {
          key: "en"
          value: "Poaching"
        }
      }
    }
    items {
      code: "fire"
      label {
        values {
          key: "en"
          value: "Fire"
        }
      }
    }
    items {
      code: "encroachment"
      label {
        values {
          key: "en"
          value: "Encroachment"
        }
      }
    }
    items {
      code: "mining"
      label {
        values {
          key: "en"
          value: "Mining"
        }
      }
    }
    items {
      code: "grazing"
      label {
        values {
          key: "en"
          value: "Grazing"
        }
      }
    }
    items {
      code: "other"
      label {
        values {
          key: "en"
          value: "Other"
        }
      }
    }
  }
  aggregation: COUNT_BY_CODE
  privacy_class: AGGREGATE_PUBLIC
  goals: "effective_protected_areas"
  pillar: PROTECTION
  status: STABLE
}
concepts {
  id: "pame.threat_severity"
  version: 1
  label {
    values {
      key: "en"
      value: "Threat severity"
    }
  }
  description {
    values {
      key: "en"
      value: "How severe the observed threat is."
    }
  }
  data_type: TYPE_SELECT_ONE
  code_list {
    items {
      code: "low"
      label {
        values {
          key: "en"
          value: "Low"
        }
      }
    }
    items {
      code: "medium"
      label {
        values {
          key: "en"
          value: "Medium"
        }
      }
    }
    items {
      code: "high"
      label {
        values {
          key: "en"
          value: "High"
        }
      }
    }
  }
  aggregation: SHARE_BY_CODE
  privacy_class: AGGREGATE_PUBLIC
  goals: "effective_protected_areas"
  pillar: PROTECTION
  status: STABLE
}
concepts {
  id: "pame.patrol_effort_km"
  version: 1
  label {
    values {
      key: "en"
      value: "Patrol effort (km)"
