purpose_packs {
  id: "producer_registration"
  title {
    values {
      key: "en"
      value: "Producer registration & market access"
    }
    values {
      key: "fr"
      value: "Enregistrement des producteurs et accès aux marchés"
    }
    values {
      key: "es"
      value: "Registro de productores y acceso a mercados"
    }
    values {
      key: "vi"
      value: "Đăng ký nông hộ và tiếp cận thị trường"
    }
    values {
      key: "sw"
      value: "Usajili wa wazalishaji na upatikanaji wa masoko"
    }
  }
  description {
    values {
      key: "en"
      value: "Register smallholder farmers, cooperatives, household demographics, and harvest volumes to support cooperative services and certified market access."
    }
  }
  icon: "person_add"
  form_template_ids: "producer_profile"
  program_ids: "rainforest_alliance"
  program_ids: "fairtrade"
  program_ids: "agstack"
  program_ids: "organic"
  goals: "smallholder_livelihoods"
  pillar: ADAPTATION
  status: STABLE
}
