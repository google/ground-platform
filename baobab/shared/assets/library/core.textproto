form_templates {
  id: "producer_profile"
  title {
    values {
      key: "en"
      value: "Producer profile"
    }
    values {
      key: "fr"
      value: "Profil du producteur"
    }
    values {
      key: "es"
      value: "Perfil del productor"
    }
  }
  description {
    values {
      key: "en"
      value: "Registers a farmer or producer with their household details."
    }
  }
  form {
    form_id: "producer_profile"
    title: "Producer profile"
    version: "1"
    model {
      primary_instance {
        record_schema {
          name: "data"
          title: "Producer profile"
          fields {
            name: "data_consent"
            type: TYPE_SELECT_ONE
          }
          fields {
            name: "producer_name"
            type: TYPE_STRING
          }
          fields {
            name: "producer_id"
            type: TYPE_STRING
          }
          fields {
            name: "producer_gender"
            type: TYPE_SELECT_ONE
          }
          fields {
            name: "household_size"
            type: TYPE_INT32
          }
          fields {
            name: "country"
            type: TYPE_STRING
          }
          fields {
            name: "admin_area"
            type: TYPE_STRING
          }
        }
      }
      bindings {
        field_path: "data_consent"
        type: TYPE_SELECT_ONE
        required_expression: "true()"
      }
      bindings {
        field_path: "producer_name"
        type: TYPE_STRING
        required_expression: "true()"
      }
      bindings {
        field_path: "producer_id"
        type: TYPE_STRING
      }
      bindings {
        field_path: "producer_gender"
        type: TYPE_SELECT_ONE
      }
      bindings {
        field_path: "household_size"
        type: TYPE_INT32
      }
      bindings {
        field_path: "country"
        type: TYPE_STRING
      }
      bindings {
        field_path: "admin_area"
        type: TYPE_STRING
      }
    }
    view {
      components {
        control {
          field_ref: "data_consent"
          type: CONTROL_SELECT_ONE
          label {
            text: "Consent to data collection"
          }
          choices {
            value: "yes"
            label {
              text: "Yes"
            }
          }
          choices {
            value: "no"
            label {
              text: "No"
            }
          }
        }
      }
      components {
        control {
          field_ref: "producer_name"
          type: CONTROL_INPUT
          label {
            text: "Producer name"
          }
        }
      }
      components {
        control {
          field_ref: "producer_id"
          type: CONTROL_INPUT
          label {
            text: "Producer ID"
          }
        }
      }
      components {
        control {
          field_ref: "producer_gender"
          type: CONTROL_SELECT_ONE
          label {
            text: "Producer gender"
          }
          choices {
            value: "female"
            label {
              text: "Female"
            }
          }
          choices {
            value: "male"
            label {
              text: "Male"
            }
          }
          choices {
            value: "other"
            label {
              text: "Other"
            }
          }
          choices {
            value: "prefer_not_to_say"
            label {
              text: "Prefer not to say"
            }
          }
        }
      }
      components {
        control {
          field_ref: "household_size"
          type: CONTROL_INPUT
          label {
            text: "Household size"
          }
        }
      }
      components {
        control {
          field_ref: "country"
          type: CONTROL_INPUT
          label {
            text: "Country"
          }
        }
      }
      components {
        control {
          field_ref: "admin_area"
          type: CONTROL_INPUT
          label {
            text: "Administrative area"
          }
        }
      }
    }
  }
  status: STABLE
}
