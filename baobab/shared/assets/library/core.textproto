    }
    values {
      key: "sw"
      value: "Usajili wa mzalishaji na shamba"
    }
  }
  description {
    values {
      key: "en"
      value: "Registers a smallholder farmer with consent, cooperative membership, household details, certification status, and annual production."
    }
  }
  form {
    form_id: "producer_profile"
    title: "Producer & farm registration"
    version: "1"
    model {
      primary_instance {
