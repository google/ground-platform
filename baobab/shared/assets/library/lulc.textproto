        field_path: "land_cover_class"
        type: TYPE_SELECT_ONE
        required_expression: "true()"
        foreign_attributes {
          namespace_uri: "http://groundplatform.org/xforms"
          qualified_name: "ground:concept"
          value: "lulc.land_cover_class@1"
        }
      }
      bindings {
        field_path: "land_use"
        type: TYPE_SELECT_ONE
        foreign_attributes {
          namespace_uri: "http://groundplatform.org/xforms"
