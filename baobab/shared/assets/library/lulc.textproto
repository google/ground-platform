          namespace_uri: "http://groundplatform.org/xforms"
          qualified_name: "ground:concept"
          value: "core.site_photo@1"
        }
      }
    }
    view {
      components {
        control {
          field_ref: "land_cover_class"
          type: CONTROL_SELECT_ONE
          label {
            text: "Land cover class"
          }
          itemset {
            instance_id: "land_cover_class"
            value_ref: "name"
            label_ref: "label"
            nodeset_path: "/root/item"
          }
        }
      }
      components {
        control {
          field_ref: "forest_stratum"
          type: CONTROL_SELECT_ONE
          label {
            text: "Forest structure & stratum"
          }
          itemset {
            instance_id: "forest_stratum"
            value_ref: "name"
            label_ref: "label"
            nodeset_path: "/root/item"
          }
        }
      }
      components {
        control {
          field_ref: "canopy_cover_pct"
          type: CONTROL_INPUT
          label {
            text: "Canopy cover (%)"
          }
        }
      }
      components {
        control {
          field_ref: "tree_height_m"
          type: CONTROL_INPUT
          label {
            text: "Tree height (m)"
          }
        }
      }
      components {
        control {
          field_ref: "basal_area_m2_ha"
          type: CONTROL_INPUT
          label {
            text: "Basal area (m²/ha)"
          }
          hint {
            text: "Stand basal area in m²/ha."
          }
        }
      }
      components {
        control {
          field_ref: "disturbance_driver"
          type: CONTROL_SELECT_MULTIPLE
          label {
            text: "Observed disturbance or degradation"
          }
          itemset {
            instance_id: "disturbance_driver"
            value_ref: "name"
            label_ref: "label"
            nodeset_path: "/root/item"
          }
        }
      }
      components {
        control {
          field_ref: "observation_date"
          type: CONTROL_INPUT
          label {
            text: "Observation date"
          }
        }
      }
      components {
        control {
          field_ref: "site_photo"
          type: CONTROL_UPLOAD
          label {
            text: "Site photo"
          }
          media_type: "image/*"
        }
      }
    }
  }
  status: STABLE
}
