        field_path: "observation_date"
        type: TYPE_DATE
        foreign_attributes {
          namespace_uri: "http://groundplatform.org/xforms"
          qualified_name: "ground:concept"
          value: "lulc.observation_date@1"
        }
      }
    }
    view {
      components {
        control {
          field_ref: "land_cover_class"
          type: CONTROL_SELECT_ONE
          label {
            text: "Land cover class"
          }
          itemset {
            instance_id: "land_cover_class"
            value_ref: "name"
            label_ref: "label"
            nodeset_path: "/root/item"
          }
        }
      }
      components {
        control {
          field_ref: "land_use"
          type: CONTROL_SELECT_ONE
          label {
            text: "Land use"
          }
          itemset {
            instance_id: "land_use"
            value_ref: "name"
            label_ref: "label"
            nodeset_path: "/root/item"
          }
        }
      }
      components {
        control {
          field_ref: "canopy_cover_pct"
          type: CONTROL_INPUT
          label {
            text: "Canopy cover (%)"
          }
        }
      }
      components {
        control {
          field_ref: "observation_date"
          type: CONTROL_INPUT
          label {
            text: "Observation date"
          }
        }
      }
    }
  }
  status: STABLE
}
