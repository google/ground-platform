  id: "iplc.tenure_type"
  version: 1
  label {
    values {
      key: "en"
      value: "Land tenure type"
    }
  }
  description {
    values {
      key: "en"
      value: "How rights to the land are held."
    }
  }
  keywords {
    values {
      key: "en"
      value: "land rights"
    }
  }
  keywords {
    values {
      key: "en"
      value: "ownership"
    }
  }
  data_type: TYPE_SELECT_ONE
  code_list {
    items {
      code: "customary"
      label {
        values {
          key: "en"
          value: "Customary"
        }
      }
    }
    items {
      code: "communal"
      label {
        values {
          key: "en"
          value: "Communal"
        }
      }
    }
    items {
      code: "private"
      label {
        values {
          key: "en"
          value: "Private"
        }
      }
    }
    items {
      code: "public"
      label {
        values {
          key: "en"
          value: "Public"
        }
      }
    }
    items {
      code: "other"
      label {
        values {
          key: "en"
          value: "Other"
        }
      }
    }
  }
  aggregation: COUNT_BY_CODE
  privacy_class: ORG_ONLY
  goals: "iplc_rights_and_tenure"
  pillar: PROTECTION
  status: STABLE
}
concepts {
  id: "iplc.fpic_consent"
  version: 1
  label {
    values {
      key: "en"
      value: "Free, prior and informed consent"
    }
  }
  description {
    values {
      key: "en"
      value: "Status of the community's free, prior and informed consent (FPIC)."
    }
  }
  keywords {
    values {
      key: "en"
      value: "fpic"
    }
  }
  keywords {
    values {
      key: "en"
      value: "consent"
    }
  }
  data_type: TYPE_SELECT_ONE
  code_list {
    items {
      code: "given"
      label {
        values {
          key: "en"
          value: "Given"
        }
      }
    }
    items {
      code: "withheld"
      label {
        values {
          key: "en"
          value: "Withheld"
        }
      }
    }
    items {
      code: "pending"
      label {
        values {
          key: "en"
          value: "Pending"
        }
      }
    }
  }
  aggregation: SHARE_BY_CODE
  privacy_class: SENSITIVE
  goals: "iplc_rights_and_tenure"
  pillar: PROTECTION
