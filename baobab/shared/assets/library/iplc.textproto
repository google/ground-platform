concepts {
  id: "iplc.territory_boundary"
  version: 1
  label {
    values {
      key: "en"
      value: "Territory boundary"
    }
  }
  description {
    values {
      key: "en"
      value: "Boundary of the community's territory, mapped with the community."
    }
  }
  keywords {
    values {
      key: "en"
      value: "territory"
    }
  }
  keywords {
    values {
      key: "en"
      value: "community land"
    }
  }
  data_type: TYPE_GEOSHAPE
  aggregation: COUNT_DISTINCT_FEATURES
  privacy_class: SENSITIVE
  goals: "iplc_rights_and_tenure"
  pillar: PROTECTION
  status: STABLE
}
