  <!-- Progress of saving an area for offline use. %1$d: percent done, e.g. 27. -->
  <string name="mobile_offline_area_saving">Đang lưu để dùng ngoại tuyến… %1$d%</string>
  <!-- How much of an area was saved so far. %1$s: saved, e.g. "13 MB"; %2$s: estimated total, e.g. "48 MB". -->
  <string name="mobile_offline_area_saving_size">%1$s trên khoảng %2$s</string>
  <!-- Shown when an area finished saving for offline use. -->
  <string name="mobile_offline_area_saved">Đã lưu để dùng ngoại tuyến</string>
  <!-- Saving an area stopped because the device reached its limit of offline imagery. -->
  <string name="mobile_offline_area_tile_limit">Thiết bị này đã đạt giới hạn hình ảnh ngoại tuyến. Hãy xóa một khu vực để lưu thêm.</string>
  <!-- Saving an area stopped because of an error. -->
  <string name="mobile_offline_area_failed">Không thể lưu khu vực này.</string>
  <!-- Button that hides the saving progress while the area keeps saving. -->
  <string name="mobile_hide">Ẩn</string>
  <!-- Button that closes the area framing mode after an area was saved. -->
  <string name="mobile_done">Xong</string>
  <!-- Button that tries a failed estimate or save again. -->
  <string name="mobile_try_again">Thử lại</string>
  <!-- Button that resumes saving a paused layer of a saved area. -->
  <string name="mobile_resume">Tiếp tục</string>
  <!-- Notice in the mobile app in a web browser, where saving map areas is only simulated. -->
  <string name="mobile_offline_area_simulated_notice">Tải xuống mô phỏng. Bản đồ ngoại tuyến chỉ hoạt động trong ứng dụng Android và iOS.</string>
  <!-- Banner on Offline maps in the mobile app in a web browser, where saving map areas is only simulated. -->
  <string name="mobile_offline_maps_simulated_banner">Tải xuống ở đây chỉ là mô phỏng: không có hình ảnh nào được lưu và tên khu vực chỉ là tên mẫu. Để dùng bản đồ khi không có internet, hãy lưu khu vực trong ứng dụng Android hoặc iOS.</string>
  <!-- Label on a saved area or layer that was only simulated (mobile app in a web browser). -->
  <string name="mobile_offline_maps_simulated_label">Mô phỏng</string>
  <!-- Empty state of Offline maps when no area is saved. -->
  <string name="mobile_offline_maps_empty_title">Chưa lưu khu vực nào để dùng ngoại tuyến</string>
  <string name="mobile_offline_maps_empty_body">Lưu các khu vực bạn làm việc để xem bản đồ khi không có internet.</string>
  <!-- When a saved area was saved and what removing it frees. %1$s: date, e.g. "Oct 30, 2026"; %2$s: size, e.g. "48 MB". -->
  <string name="mobile_offline_maps_area_summary">Đã lưu %1$s · tối đa %2$s</string>
  <!-- Percent saved of a layer of a saved area. %1$d: percent, e.g. 62. -->
  <string name="mobile_offline_maps_layer_percent">%1$d%</string>
  <!-- Status of a layer of a saved area whose download stopped before it finished. -->
  <string name="mobile_offline_maps_layer_paused">Đã tạm dừng</string>
  <!-- Status of a layer of a saved area whose download failed. -->
  <string name="mobile_offline_maps_layer_failed">Không lưu được</string>
  <!-- Accessibility label of the menu of a saved area. %1$s: area name. -->
  <string name="mobile_offline_maps_area_options">Tùy chọn cho %1$s</string>
  <!-- Accessibility label of the menu of a layer of a saved area. %1$s: layer, e.g. "Satellite". -->
  <string name="mobile_offline_maps_layer_options">Tùy chọn cho %1$s</string>
  <!-- Menu item that shows a saved area on the map. -->
  <string name="mobile_offline_maps_show_on_map">Hiện trên bản đồ</string>
  <!-- Menu item and confirmation button that remove a saved area. -->
  <string name="mobile_offline_maps_remove_area">Xóa khu vực</string>
  <!-- Title of the confirmation before removing a saved area. -->
  <string name="mobile_offline_maps_remove_area_title">Xóa khu vực đã lưu?</string>
  <!-- Body of the confirmation before removing a saved area. %1$s: area name; %2$s: size, e.g. "48 MB". -->
  <string name="mobile_offline_maps_remove_area_body">Xóa "%1$s" sẽ giải phóng tối đa %2$s. Bạn sẽ cần internet để xem lại khu vực này khi ngoại tuyến.</string>
  <!-- Menu item and confirmation button that remove the satellite layer of a saved area. -->
  <string name="mobile_offline_maps_remove_satellite">Xóa vệ tinh</string>
  <!-- Menu item and confirmation button that remove the terrain layer of a saved area. -->
  <string name="mobile_offline_maps_remove_terrain">Xóa địa hình</string>
  <!-- Title of the confirmation before removing the satellite layer of a saved area. %1$s: area name. -->
  <string name="mobile_offline_maps_remove_satellite_title">Xóa vệ tinh khỏi "%1$s"?</string>
  <!-- Title of the confirmation before removing the terrain layer of a saved area. %1$s: area name. -->
  <string name="mobile_offline_maps_remove_terrain_title">Xóa địa hình khỏi "%1$s"?</string>
  <!-- Body of the confirmation before removing a layer of a saved area. %1$s: size, e.g. "38 MB". -->
  <string name="mobile_offline_maps_remove_layer_body">Thao tác này giải phóng tối đa %1$s. Bạn sẽ cần internet để xem lại hình ảnh này.</string>

