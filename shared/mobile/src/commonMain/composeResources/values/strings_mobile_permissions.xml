<resources>
  <!-- Title of the dialog explaining why the app needs the device's location, shown before asking again for a permission the user denied. -->
  <string name="mobile_location_rationale_title">Allow location access</string>
  <!-- Body of the location permission explanation. -->
  <string name="mobile_location_rationale_message">Location questions record where you are. Allow Collect One to use this device's location so it can capture points, lines, and areas.</string>
  <!-- Button that goes on to the system's location permission dialog. -->
  <string name="mobile_location_rationale_continue">Continue</string>
  <!-- Button that closes the explanation without asking for the permission. -->
  <string name="mobile_location_rationale_not_now">Not now</string>
</resources>
