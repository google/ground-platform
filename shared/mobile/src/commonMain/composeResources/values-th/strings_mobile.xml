  <!-- Title of the map mode where the user frames an area to save for offline use. -->
  <string name="mobile_offline_area_title">บันทึกพื้นที่ไว้ใช้แบบออฟไลน์</string>
  <!-- Hint under the title while framing an area to save for offline use. -->
  <string name="mobile_offline_area_hint">เลื่อนและซูมแผนที่ให้พื้นที่ทำงานของคุณอยู่ในกรอบ</string>
  <!-- Accessibility label of the button that leaves the area framing mode. -->
  <string name="mobile_offline_area_close">ปิด</string>
  <!-- Shown while the name of the framed place is looked up. -->
  <string name="mobile_offline_area_finding_name">กำลังค้นหาชื่อสถานที่…</string>
  <!-- Name of a saved map area when no place name was found. %1$s: coordinates of its center, e.g. "0.4160°S, 36.9470°E". -->
  <string name="mobile_offline_area_near">พื้นที่ใกล้ %1$s</string>
  <!-- Shown while the download size of the framed area is estimated. -->
  <string name="mobile_offline_area_estimating">กำลังประเมินขนาด…</string>
  <!-- Estimated download size of the framed area and the free space on the device. %1$s: size, e.g. "48 MB"; %2$s: free space, e.g. "12.4 GB". -->
  <string name="mobile_offline_area_estimate">ประมาณ %1$s · ว่าง %2$s</string>
  <!-- Estimated download size of the framed area when the free space is unknown. %1$s: size, e.g. "48 MB". -->
  <string name="mobile_offline_area_estimate_size">ประมาณ %1$s</string>
  <!-- The framed area is too large to save. %1$s: its area, e.g. "140 km²"; %2$s: the largest area, e.g. "50 km²". -->
  <string name="mobile_offline_area_too_large">พื้นที่นี้มีขนาดประมาณ %1$s ซูมเข้าเพื่อเลือกไม่เกิน %2$s</string>
  <!-- The device lacks space to save the framed area. %1$s: space to free, e.g. "120 MB". -->
  <string name="mobile_offline_area_not_enough_space">พื้นที่ไม่พอ ล้างพื้นที่ %1$s เพื่อบันทึกพื้นที่นี้</string>
  <!-- The device is offline, so the framed area can't be estimated or saved. -->
  <string name="mobile_offline_area_offline">คุณออฟไลน์อยู่ เชื่อมต่ออินเทอร์เน็ตเพื่อบันทึกพื้นที่นี้</string>
  <!-- The framed area spans the 180° meridian, which saved areas can't. -->
  <string name="mobile_offline_area_crosses_antimeridian">พื้นที่นี้ข้ามเส้นเมริเดียน 180° เลื่อนแผนที่เพื่อเลือกพื้นที่ด้านใดด้านหนึ่ง</string>
  <!-- This build of the app can't save map areas. -->
  <string name="mobile_offline_area_unavailable">อุปกรณ์นี้บันทึกพื้นที่แผนที่ไม่ได้</string>
  <!-- The size of the framed area couldn't be estimated, for a reason other than the connection. -->
  <string name="mobile_offline_area_estimate_failed">ประเมินขนาดของพื้นที่นี้ไม่ได้</string>
  <!-- Primary button that saves the framed area for offline use. -->
  <string name="mobile_offline_area_save">บันทึกไว้ใช้ออฟไลน์</string>
  <!-- Progress of saving an area for offline use. %1$d: percent done, e.g. 27. -->
  <string name="mobile_offline_area_saving">กำลังบันทึกไว้ใช้ออฟไลน์… %1$d%</string>
  <!-- How much of an area was saved so far. %1$s: saved, e.g. "13 MB"; %2$s: estimated total, e.g. "48 MB". -->
  <string name="mobile_offline_area_saving_size">%1$s จากประมาณ %2$s</string>
  <!-- Shown when an area finished saving for offline use. -->
  <string name="mobile_offline_area_saved">บันทึกไว้ใช้ออฟไลน์แล้ว</string>
  <!-- Saving an area stopped because the device reached its limit of offline imagery. -->
  <string name="mobile_offline_area_tile_limit">อุปกรณ์นี้ใช้ภาพออฟไลน์ครบขีดจำกัดแล้ว ลบพื้นที่ออกเพื่อบันทึกเพิ่ม</string>
  <!-- Saving an area stopped because of an error. -->
  <string name="mobile_offline_area_failed">บันทึกพื้นที่นี้ไม่ได้</string>
  <!-- Button that hides the saving progress while the area keeps saving. -->
  <string name="mobile_hide">ซ่อน</string>
  <!-- Button that closes the area framing mode after an area was saved. -->
  <string name="mobile_done">เสร็จสิ้น</string>
  <!-- Button that tries a failed estimate or save again. -->
  <string name="mobile_try_again">ลองอีกครั้ง</string>
  <!-- Button that resumes saving a paused layer of a saved area. -->
  <string name="mobile_resume">ดำเนินการต่อ</string>
  <!-- Notice in the mobile app in a web browser, where saving map areas is only simulated. -->
  <string name="mobile_offline_area_simulated_notice">การดาวน์โหลดจำลอง แผนที่ออฟไลน์ใช้ได้เฉพาะในแอป Android และ iOS</string>
  <!-- Banner on Offline maps in the mobile app in a web browser, where saving map areas is only simulated. -->
  <string name="mobile_offline_maps_simulated_banner">การดาวน์โหลดที่นี่เป็นการจำลอง: ไม่มีการบันทึกภาพ และชื่อพื้นที่เป็นชื่อตัวอย่าง หากต้องการใช้แผนที่โดยไม่มีอินเทอร์เน็ต ให้บันทึกพื้นที่ในแอป Android หรือ iOS</string>
  <!-- Label on a saved area or layer that was only simulated (mobile app in a web browser). -->
  <string name="mobile_offline_maps_simulated_label">จำลอง</string>
  <!-- Empty state of Offline maps when no area is saved. -->
  <string name="mobile_offline_maps_empty_title">ยังไม่มีพื้นที่ที่บันทึกไว้ใช้ออฟไลน์</string>
  <string name="mobile_offline_maps_empty_body">บันทึกพื้นที่ที่คุณทำงานไว้ เพื่อดูแผนที่ได้โดยไม่ต้องใช้อินเทอร์เน็ต</string>
  <!-- When a saved area was saved and what removing it frees. %1$s: date, e.g. "Oct 30, 2026"; %2$s: size, e.g. "48 MB". -->
  <string name="mobile_offline_maps_area_summary">บันทึกเมื่อ %1$s · สูงสุด %2$s</string>
  <!-- Percent saved of a layer of a saved area. %1$d: percent, e.g. 62. -->
  <string name="mobile_offline_maps_layer_percent">%1$d%</string>
  <!-- Status of a layer of a saved area whose download stopped before it finished. -->
  <string name="mobile_offline_maps_layer_paused">หยุดชั่วคราว</string>
  <!-- Status of a layer of a saved area whose download failed. -->
  <string name="mobile_offline_maps_layer_failed">บันทึกไม่ได้</string>
  <!-- Accessibility label of the menu of a saved area. %1$s: area name. -->
  <string name="mobile_offline_maps_area_options">ตัวเลือกสำหรับ %1$s</string>
  <!-- Accessibility label of the menu of a layer of a saved area. %1$s: layer, e.g. "Satellite". -->
  <string name="mobile_offline_maps_layer_options">ตัวเลือกสำหรับ %1$s</string>
  <!-- Menu item that shows a saved area on the map. -->
  <string name="mobile_offline_maps_show_on_map">แสดงบนแผนที่</string>
  <!-- Menu item and confirmation button that remove a saved area. -->
  <string name="mobile_offline_maps_remove_area">ลบพื้นที่</string>
  <!-- Title of the confirmation before removing a saved area. -->
  <string name="mobile_offline_maps_remove_area_title">ลบพื้นที่ที่บันทึกไว้ไหม</string>
  <!-- Body of the confirmation before removing a saved area. %1$s: area name; %2$s: size, e.g. "48 MB". -->
  <string name="mobile_offline_maps_remove_area_body">การลบ "%1$s" จะคืนพื้นที่ได้สูงสุด %2$s คุณจะต้องใช้อินเทอร์เน็ตเพื่อดูพื้นที่นี้แบบออฟไลน์อีกครั้ง</string>
  <!-- Menu item and confirmation button that remove the satellite layer of a saved area. -->
  <string name="mobile_offline_maps_remove_satellite">ลบดาวเทียม</string>
  <!-- Menu item and confirmation button that remove the terrain layer of a saved area. -->
  <string name="mobile_offline_maps_remove_terrain">ลบภูมิประเทศ</string>
  <!-- Title of the confirmation before removing the satellite layer of a saved area. %1$s: area name. -->
  <string name="mobile_offline_maps_remove_satellite_title">ลบดาวเทียมออกจาก "%1$s" ไหม</string>
  <!-- Title of the confirmation before removing the terrain layer of a saved area. %1$s: area name. -->
  <string name="mobile_offline_maps_remove_terrain_title">ลบภูมิประเทศออกจาก "%1$s" ไหม</string>
  <!-- Body of the confirmation before removing a layer of a saved area. %1$s: size, e.g. "38 MB". -->
  <string name="mobile_offline_maps_remove_layer_body">การดำเนินการนี้จะคืนพื้นที่ได้สูงสุด %1$s คุณจะต้องใช้อินเทอร์เน็ตเพื่อดูภาพนี้อีกครั้ง</string>

  <!-- Mobile client version update prompts -->
  <string name="mobile_update_available_title">มีอัปเดตพร้อมใช้งาน</string>
  <string name="mobile_update_available_body">มี Collect One เวอร์ชันใหม่กว่า (%1$s) พร้อมใช้งานแล้ว</string>
  <string name="mobile_update_required_title">จำเป็นต้องอัปเดต</string>
  <string name="mobile_update_required_body">Collect One เวอร์ชันนี้ (%1$s) ไม่รองรับอีกต่อไป โปรดอัปเดตเป็น %2$s หรือสูงกว่าเพื่อใช้งานต่อ</string>
  <string name="mobile_update_now">อัปเดตตอนนี้</string>
  <string name="mobile_update_later">ภายหลัง</string>
  <string name="mobile_update_check_again">ตรวจสอบอีกครั้ง</string>
</resources>
