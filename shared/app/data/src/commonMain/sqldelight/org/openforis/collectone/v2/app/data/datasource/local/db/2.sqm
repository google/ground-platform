-- Version 2 to 3: adds the active survey (ActiveSurvey.sq). Every other table, including the
-- outbox, the server bases, the stored account, and the signed-in session, is kept as is.
-- The survey the user last opened on this device, so a relaunch reopens it
-- (docs/technical/client/local-data-store.md, "Active Survey"). A single row, deleted on sign-out
-- and when the survey is removed from the device.
CREATE TABLE active_survey (
  id INTEGER NOT NULL PRIMARY KEY CHECK (id = 0),
  survey_id TEXT NOT NULL
);
