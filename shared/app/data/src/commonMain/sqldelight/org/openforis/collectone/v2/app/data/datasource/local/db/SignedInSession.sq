-- The account signed in on this device, so the app relaunches offline straight into the app as that
-- account (docs/technical/client/local-data-store.md, "Signed-In Account"). A single row, deleted on
-- sign-out. Only what the app shows and needs to identify the account: no tokens or credentials.
CREATE TABLE signed_in_session (
  id INTEGER NOT NULL PRIMARY KEY CHECK (id = 0),
  email TEXT NOT NULL,
  display_name TEXT NOT NULL,
  organization TEXT NOT NULL,
  photo_url TEXT,
  -- The email of the account that accepted the Terms of Service after signing in, else NULL. The
  -- acceptance applies only to that account.
  terms_accepted_email TEXT
);

select:
SELECT email, display_name, organization, photo_url, terms_accepted_email
FROM signed_in_session WHERE id = 0;

put:
INSERT OR REPLACE INTO signed_in_session(id, email, display_name, organization, photo_url, terms_accepted_email)
VALUES (0, ?, ?, ?, ?, ?);

delete:
DELETE FROM signed_in_session;
