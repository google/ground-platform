-- Version 4 to 5: adds the map areas saved for offline use (OfflineMapArea.sq). Every other table,
-- including the outbox and the server bases, is kept as is.
-- Map areas saved on this device for offline use (docs/technical/client/local-data-store.md,
-- "Offline Map Areas"). They belong to the device and survive signing out.
CREATE TABLE offline_map_area (
  id TEXT NOT NULL PRIMARY KEY,
  -- The place name (OfflineAreaName.Named), or NULL when the area is named after the position in
  -- name_lat and name_lng (OfflineAreaName.NearCoordinates).
  name TEXT,
  name_lat REAL,
  name_lng REAL,
  west REAL NOT NULL,
  south REAL NOT NULL,
  east REAL NOT NULL,
  north REAL NOT NULL,
  -- When the user saved the area, in milliseconds since the epoch.
  created_at INTEGER NOT NULL
);

-- One imagery layer of a saved area (OfflineAreaLayer), backed by its own tile region.
CREATE TABLE offline_map_area_layer (
  area_id TEXT NOT NULL REFERENCES offline_map_area(id) ON DELETE CASCADE,
  -- OfflineImageryType: SATELLITE or TERRAIN.
  imagery_type TEXT NOT NULL,
  -- OfflineAreaLayerStatus: SAVING, READY, PAUSED, or FAILED.
  status TEXT NOT NULL,
  -- The size on the device once saved, or the estimate while saving; NULL when unknown.
  size_bytes INTEGER,
  PRIMARY KEY (area_id, imagery_type)
);
