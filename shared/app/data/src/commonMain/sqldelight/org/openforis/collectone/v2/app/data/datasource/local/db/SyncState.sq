-- The install's mutation identity and the sync tokens of each synced List* scope
-- (docs/technical/sync-engine.md, "Sync Tokens"). A single row, written in the same transaction as
-- the outbox and bases it describes.
CREATE TABLE sync_state (
  id INTEGER NOT NULL PRIMARY KEY CHECK (id = 0),
  -- Stable identifier of this install (client_id), or blank until first assigned.
  client_id TEXT NOT NULL,
  -- The client_seq the next recorded mutation gets.
  next_client_seq INTEGER NOT NULL,
  -- Opaque tokens as an encoded openforis.collectone.v1.userdata.SyncTokensRecord.
  sync_tokens BLOB NOT NULL
);

-- Surveys the user downloaded to this device.
CREATE TABLE downloaded_survey (
  survey_id TEXT NOT NULL PRIMARY KEY
);

-- The account the stored state belongs to: the signed-in account's email, or blank for sample and
-- development accounts. State stored for another account is never restored.
CREATE TABLE stored_account (
  id INTEGER NOT NULL PRIMARY KEY CHECK (id = 0),
  account TEXT NOT NULL
);

select:
SELECT client_id, next_client_seq, sync_tokens FROM sync_state WHERE id = 0;

put:
INSERT OR REPLACE INTO sync_state(id, client_id, next_client_seq, sync_tokens) VALUES (0, ?, ?, ?);

selectDownloadedSurveyIds:
SELECT survey_id FROM downloaded_survey ORDER BY survey_id;

insertDownloadedSurvey:
INSERT OR IGNORE INTO downloaded_survey(survey_id) VALUES (?);

selectAccount:
SELECT account FROM stored_account WHERE id = 0;

putAccount:
INSERT OR REPLACE INTO stored_account(id, account) VALUES (0, ?);

deleteAll {
  DELETE FROM sync_state;
  DELETE FROM downloaded_survey;
  DELETE FROM stored_account;
}

deleteDownloadedSurveys:
DELETE FROM downloaded_survey;
