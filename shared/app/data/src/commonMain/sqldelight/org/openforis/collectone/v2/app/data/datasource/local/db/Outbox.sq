-- The outbox: local edits recorded as fine-grained mutations, waiting to be sent or confirmed
-- (docs/technical/sync-engine.md). One row per mutation; the row is deleted once the server
-- confirms it.
CREATE TABLE outbox_mutation (
  mutation_id TEXT NOT NULL PRIMARY KEY,
  -- Position in the install's mutation sequence; mutations are sent in this order.
  client_seq INTEGER NOT NULL,
  -- The whole entry (target, payload, attempts, state) as an encoded
  -- openforis.collectone.v1.userdata.PendingMutationRecord.
  record BLOB NOT NULL
);

CREATE INDEX outbox_mutation_by_client_seq ON outbox_mutation(client_seq);

selectAll:
SELECT record FROM outbox_mutation ORDER BY client_seq;

upsert:
INSERT OR REPLACE INTO outbox_mutation(mutation_id, client_seq, record) VALUES (?, ?, ?);

delete:
DELETE FROM outbox_mutation WHERE mutation_id = ?;

deleteAll:
DELETE FROM outbox_mutation;
