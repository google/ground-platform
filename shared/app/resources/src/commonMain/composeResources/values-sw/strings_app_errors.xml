<resources>
  <!-- Why an operation failed: the user data service or auth service couldn't be reached. -->
  <string name="app_error_network">Imeshindwa kuunganisha. Angalia muunganisho wako wa intaneti kisha ujaribu tena.</string>
  <!-- Why an operation failed: the user's session has expired. -->
  <string name="app_error_unauthenticated">Muda wa kipindi chako umeisha. Ingia tena.</string>
  <!-- Why an operation failed: the signed-in user isn't allowed to do it. -->
  <string name="app_error_permission_denied">Huna ruhusa ya kufanya hivi.</string>
  <!-- Why an operation failed: what it refers to was deleted. -->
  <string name="app_error_not_found">Kipengee hiki hakipo tena.</string>
  <!-- Why an operation failed: someone changed the same thing at the same time. -->
  <string name="app_error_conflict">Hiki kimebadilishwa mahali pengine. Jaribu tena.</string>
  <!-- Why an operation failed: what it changes no longer accepts changes, e.g. a closed or archived survey; retrying won't help. -->
  <string name="app_error_not_editable">Hiki hakiwezi kubadilishwa sasa. Huenda utafiti umefungwa au umehifadhiwa kwenye kumbukumbu.</string>
  <!-- Why an operation failed: the server rejected what was entered. -->
  <string name="app_error_validation">Baadhi ya taarifa si sahihi. Ziangalie kisha ujaribu tena.</string>
  <!-- Why an operation failed: a quota or rate limit was reached. -->
  <string name="app_error_quota_exceeded">Umefikia kikomo cha matumizi. Jaribu tena baadaye.</string>
  <!-- Why an operation failed: the user cancelled it. -->
  <string name="app_error_cancelled">Imeghairiwa.</string>
  <!-- Why an operation failed, when there is no more specific reason. -->
  <string name="app_error_unknown">Hitilafu imetokea. Jaribu tena.</string>
  <!-- Notice after sign-in fails. %1$s = why, one of the app_error_* sentences. -->
  <string name="app_sign_in_failed">Imeshindwa kuingia. %1$s</string>
</resources>
