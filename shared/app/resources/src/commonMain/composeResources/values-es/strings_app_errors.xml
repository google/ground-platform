<resources>
  <!-- Why an operation failed: the user data service or auth service couldn't be reached. -->
  <string name="app_error_network">No se pudo conectar. Comprueba tu conexión a Internet e inténtalo de nuevo.</string>
  <!-- Why an operation failed: the user's session has expired. -->
  <string name="app_error_unauthenticated">Tu sesión ha caducado. Vuelve a iniciar sesión.</string>
  <!-- Why an operation failed: the signed-in user isn't allowed to do it. -->
  <string name="app_error_permission_denied">No tienes permiso para hacer esto.</string>
  <!-- Why an operation failed: what it refers to was deleted. -->
  <string name="app_error_not_found">Este elemento ya no existe.</string>
  <!-- Why an operation failed: someone changed the same thing at the same time. -->
  <string name="app_error_conflict">Esto se modificó en otro lugar. Inténtalo de nuevo.</string>
  <!-- Why an operation failed: what it changes no longer accepts changes, e.g. a closed or archived survey; retrying won't help. -->
  <string name="app_error_not_editable">Esto no se puede cambiar ahora. Es posible que la encuesta esté cerrada o archivada.</string>
  <!-- Why an operation failed: the server rejected what was entered. -->
  <string name="app_error_validation">Parte de la información no es válida. Revísala e inténtalo de nuevo.</string>
  <!-- Why an operation failed: a quota or rate limit was reached. -->
  <string name="app_error_quota_exceeded">Alcanzaste un límite de uso. Inténtalo de nuevo más tarde.</string>
  <!-- Why an operation failed: the user cancelled it. -->
  <string name="app_error_cancelled">Cancelado.</string>
  <!-- Why an operation failed, when there is no more specific reason. -->
  <string name="app_error_unknown">Algo salió mal. Inténtalo de nuevo.</string>
  <!-- Notice after sign-in fails. %1$s = why, one of the app_error_* sentences. -->
  <string name="app_sign_in_failed">No se pudo iniciar sesión. %1$s</string>
</resources>
