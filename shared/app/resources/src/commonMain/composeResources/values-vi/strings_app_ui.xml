<resources>
  <!-- Title of the development-build dialog for choosing a simulated app role. -->
  <string name="app_dev_sign_in_title">Đăng nhập phát triển</string>
  <string name="app_dev_sign_in_real_accounts_intro">Bạn đã đăng nhập bằng tài khoản Google. Dịch vụ dữ liệu người dùng đang chạy ở chế độ phát triển, vì vậy hãy chọn vai trò ứng dụng để mô phỏng trong khi kiểm thử.</string>
  <string name="app_dev_sign_in_sample_users_intro">Tính năng đăng nhập Firebase đã tắt trong bản dựng này, vì vậy bạn sẽ đăng nhập bằng người dùng mẫu thay vì tài khoản của mình.</string>
  <!-- Simulated app role option. -->
  <string name="app_dev_sign_in_role_administrator">Quản trị viên</string>
  <string name="app_dev_sign_in_role_administrator_real_description">Xem và có thể thay đổi tất cả các khảo sát, tổ chức và dữ liệu mẫu.</string>
  <!-- Adam Admin is the name of a sample user. -->
  <string name="app_dev_sign_in_role_administrator_sample_description">Đăng nhập với tư cách Adam Admin, người có thể xem và thay đổi tất cả dữ liệu mẫu.</string>
  <!-- Simulated app role option. -->
  <string name="app_dev_sign_in_role_regular_user">Người dùng thông thường</string>
  <string name="app_dev_sign_in_role_regular_user_real_description">Chỉ xem các khảo sát bạn sở hữu, được mời tham gia, hoặc được tổ chức của bạn hay liên kết công khai chia sẻ với bạn.</string>
  <!-- Ima User is the name of a sample user; Kenya Forest Service is a sample organization. -->
  <string name="app_dev_sign_in_role_regular_user_sample_description">Đăng nhập với tư cách Ima User, một người thu thập dữ liệu trong tổ chức mẫu Kenya Forest Service.</string>
  <string name="app_dev_sign_in_footer">Thiết bị này sẽ ghi nhớ lựa chọn của bạn; hãy đăng xuất để chuyển vai trò. Bản dựng chính thức đăng nhập bình thường, không có hộp thoại này.</string>
