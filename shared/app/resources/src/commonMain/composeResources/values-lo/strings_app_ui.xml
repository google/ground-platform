<resources>
  <!-- Title of the development-build dialog for choosing a simulated app role. -->
  <string name="app_dev_sign_in_title">ການເຂົ້າລະບົບສຳລັບການພັດທະນາ</string>
  <string name="app_dev_sign_in_real_accounts_intro">ທ່ານເຂົ້າລະບົບດ້ວຍບັນຊີ Google ຂອງທ່ານແລ້ວ. ບໍລິການຂໍ້ມູນຜູ້ໃຊ້ເຮັດວຽກໃນໂໝດພັດທະນາ, ສະນັ້ນກະລຸນາເລືອກບົດບາດໃນແອັບທີ່ຈະຈຳລອງໃນຂະນະທົດສອບ.</string>
  <string name="app_dev_sign_in_sample_users_intro">ການເຂົ້າລະບົບ Firebase ຖືກປິດໃນບິວນີ້, ສະນັ້ນທ່ານຈະເຂົ້າລະບົບເປັນຜູ້ໃຊ້ຕົວຢ່າງແທນບັນຊີຂອງທ່ານເອງ.</string>
  <!-- Simulated app role option. -->
  <string name="app_dev_sign_in_role_administrator">ຜູ້ດູແລລະບົບ</string>
  <string name="app_dev_sign_in_role_administrator_real_description">ເຫັນ ແລະ ສາມາດປ່ຽນແປງແບບສຳຫຼວດ, ອົງກອນ ແລະ ຂໍ້ມູນຕົວຢ່າງທັງໝົດ.</string>
  <!-- Adam Admin is the name of a sample user. -->
  <string name="app_dev_sign_in_role_administrator_sample_description">ເຂົ້າລະບົບເປັນ Adam Admin ເຊິ່ງເຫັນ ແລະ ສາມາດປ່ຽນແປງຂໍ້ມູນຕົວຢ່າງທັງໝົດ.</string>
  <!-- Simulated app role option. -->
  <string name="app_dev_sign_in_role_regular_user">ຜູ້ໃຊ້ທົ່ວໄປ</string>
  <string name="app_dev_sign_in_role_regular_user_real_description">ເຫັນສະເພາະແບບສຳຫຼວດທີ່ທ່ານເປັນເຈົ້າຂອງ, ໄດ້ຮັບເຊີນ ຫຼື ທີ່ອົງກອນຂອງທ່ານ ຫຼື ລິ້ງສາທາລະນະແບ່ງປັນໃຫ້ທ່ານ.</string>
  <!-- Ima User is the name of a sample user; Kenya Forest Service is a sample organization. -->
  <string name="app_dev_sign_in_role_regular_user_sample_description">ເຂົ້າລະບົບເປັນ Ima User ເຊິ່ງເປັນຜູ້ເກັບຂໍ້ມູນໃນອົງກອນຕົວຢ່າງ Kenya Forest Service.</string>
  <string name="app_dev_sign_in_footer">ອຸປະກອນນີ້ຈະຈື່ການເລືອກຂອງທ່ານ; ອອກຈາກລະບົບເພື່ອປ່ຽນບົດບາດ. ບິວສຳລັບການນຳໃຊ້ຈິງຈະເຂົ້າລະບົບຕາມປົກກະຕິ ໂດຍບໍ່ມີກ່ອງໂຕ້ຕອບນີ້.</string>
