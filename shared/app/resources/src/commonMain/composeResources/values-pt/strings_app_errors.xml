<resources>
  <!-- Why an operation failed: the user data service or auth service couldn't be reached. -->
  <string name="app_error_network">Não foi possível conectar. Verifique sua conexão com a internet e tente novamente.</string>
  <!-- Why an operation failed: the user's session has expired. -->
  <string name="app_error_unauthenticated">Sua sessão expirou. Faça login novamente.</string>
  <!-- Why an operation failed: the signed-in user isn't allowed to do it. -->
  <string name="app_error_permission_denied">Você não tem permissão para fazer isso.</string>
  <!-- Why an operation failed: what it refers to was deleted. -->
  <string name="app_error_not_found">Este item não existe mais.</string>
  <!-- Why an operation failed: someone changed the same thing at the same time. -->
  <string name="app_error_conflict">Isto foi alterado em outro lugar. Tente novamente.</string>
  <!-- Why an operation failed: what it changes no longer accepts changes, e.g. a closed or archived survey; retrying won't help. -->
  <string name="app_error_not_editable">Isto não pode ser alterado agora. A pesquisa pode estar encerrada ou arquivada.</string>
  <!-- Why an operation failed: the server rejected what was entered. -->
  <string name="app_error_validation">Algumas informações não são válidas. Verifique-as e tente novamente.</string>
  <!-- Why an operation failed: a quota or rate limit was reached. -->
  <string name="app_error_quota_exceeded">Você atingiu um limite de uso. Tente novamente mais tarde.</string>
  <!-- Why an operation failed: the user cancelled it. -->
  <string name="app_error_cancelled">Cancelado.</string>
  <!-- Why an operation failed, when there is no more specific reason. -->
  <string name="app_error_unknown">Algo deu errado. Tente novamente.</string>
  <!-- Notice after sign-in fails. %1$s = why, one of the app_error_* sentences. -->
  <string name="app_sign_in_failed">Não foi possível fazer login. %1$s</string>
</resources>
