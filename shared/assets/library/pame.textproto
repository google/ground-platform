        }
      }
    }
    items {
      code: "encroachment"
      label {
        values {
          key: "en"
          value: "Encroachment"
        }
      }
    }
    items {
      code: "mining"
      label {
        values {
          key: "en"
          value: "Mining"
        }
      }
    }
    items {
      code: "grazing"
