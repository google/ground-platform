      value: "Loại mối đe dọa"
    }
    values {
      key: "sw"
      value: "Aina ya tishio"
    }
  }
  description {
    values {
      key: "en"
      value: "Direct pressures or threats observed at the site, aligned with the IUCN-CMP Direct Threats Classification."
