form_templates {
  id: "timber_harvest_felling"
  title {
    values {
      key: "en"
      value: "Timber harvest & chain-of-custody check"
    }
    values {
      key: "fr"
      value: "Contrôle d'abattage et chaîne de contrôle du bois"
    }
    values {
      key: "es"
      value: "Control de aprovechamiento y cadena de custodia"
    }
    values {
      key: "vi"
      value: "Kiểm tra khai thác và chuỗi hành trình sản phẩm gỗ"
    }
    values {
      key: "sw"
      value: "Ukaguzi wa uvunaji wa mbao na mnyororo wa ufuatiliaji"
    }
  }
  description {
    values {
      key: "en"
      value: "Felling and log-registration form linking log barcodes, species, dimensions, and cubic volume to stump coordinates and harvesting permits."
    }
  }
  form {
    form_id: "timber_harvest_felling"
    title: "Timber harvest & chain-of-custody check"
    version: "1"
    model {
      primary_instance {
        record_schema {
          name: "data"
          title: "Timber harvest & chain-of-custody check"
          fields {
            name: "felling_date"
            type: TYPE_DATE
          }
          fields {
            name: "felling_permit_id"
            type: TYPE_STRING
          }
          fields {
            name: "harvest_unit"
            type: TYPE_STRING
          }
          fields {
            name: "stump_location"
            type: TYPE_GEOPOINT
          }
          fields {
            name: "species"
            type: TYPE_STRING
          }
          fields {
            name: "log_id"
            type: TYPE_STRING
          }
          fields {
            name: "diameter_cm"
            type: TYPE_DOUBLE
          }
          fields {
            name: "length_m"
            type: TYPE_DOUBLE
          }
          fields {
            name: "volume_m3"
            type: TYPE_DOUBLE
          }
          fields {
            name: "site_photo"
            type: TYPE_BINARY
          }
        }
      }
      bindings {
        field_path: "felling_date"
        type: TYPE_DATE
        required_expression: "true()"
        foreign_attributes {
          namespace_uri: "http://groundplatform.org/xforms"
          qualified_name: "ground:concept"
          value: "timber.felling_date@1"
        }
      }
      bindings {
        field_path: "felling_permit_id"
        type: TYPE_STRING
        required_expression: "true()"
        foreign_attributes {
          namespace_uri: "http://groundplatform.org/xforms"
          qualified_name: "ground:concept"
          value: "timber.felling_permit_id@1"
        }
      }
      bindings {
        field_path: "harvest_unit"
        type: TYPE_STRING
        required_expression: "true()"
        foreign_attributes {
          namespace_uri: "http://groundplatform.org/xforms"
          qualified_name: "ground:concept"
          value: "timber.harvest_unit@1"
        }
      }
      bindings {
        field_path: "stump_location"
        type: TYPE_GEOPOINT
        required_expression: "true()"
        foreign_attributes {
          namespace_uri: "http://groundplatform.org/xforms"
          qualified_name: "ground:concept"
          value: "timber.stump_location@1"
        }
      }
      bindings {
        field_path: "species"
        type: TYPE_STRING
        required_expression: "true()"
        foreign_attributes {
          namespace_uri: "http://groundplatform.org/xforms"
          qualified_name: "ground:concept"
          value: "timber.species@1"
        }
      }
      bindings {
        field_path: "log_id"
        type: TYPE_STRING
        required_expression: "true()"
        foreign_attributes {
          namespace_uri: "http://groundplatform.org/xforms"
          qualified_name: "ground:concept"
          value: "timber.log_id@1"
        }
      }
      bindings {
        field_path: "diameter_cm"
        type: TYPE_DOUBLE
        foreign_attributes {
          namespace_uri: "http://groundplatform.org/xforms"
          qualified_name: "ground:concept"
          value: "timber.diameter_cm@1"
        }
      }
      bindings {
        field_path: "length_m"
        type: TYPE_DOUBLE
        foreign_attributes {
          namespace_uri: "http://groundplatform.org/xforms"
          qualified_name: "ground:concept"
          value: "timber.length_m@1"
        }
      }
      bindings {
        field_path: "volume_m3"
        type: TYPE_DOUBLE
        required_expression: "true()"
        foreign_attributes {
          namespace_uri: "http://groundplatform.org/xforms"
          qualified_name: "ground:concept"
          value: "timber.volume_m3@1"
        }
      }
      bindings {
        field_path: "site_photo"
        type: TYPE_BINARY
        foreign_attributes {
          namespace_uri: "http://groundplatform.org/xforms"
          qualified_name: "ground:concept"
          value: "core.site_photo@1"
        }
      }
    }
    view {
      components {
        control {
          field_ref: "felling_date"
          type: CONTROL_INPUT
          label {
            text: "Felling date"
          }
        }
      }
      components {
        control {
          field_ref: "felling_permit_id"
          type: CONTROL_INPUT
          label {
            text: "Felling permit or concession ID"
          }
          hint {
            text: "Harvesting permit, coupe license, or concession ID."
          }
        }
      }
      components {
        control {
          field_ref: "harvest_unit"
          type: CONTROL_INPUT
          label {
            text: "Harvest unit"
          }
          hint {
            text: "Forest management unit, compartment, or cutting block."
          }
        }
      }
      components {
        control {
          field_ref: "stump_location"
          type: CONTROL_INPUT
          label {
            text: "Stump or felling point"
          }
          hint {
            text: "Capture GPS coordinates at the felled stump."
          }
        }
      }
      components {
        control {
          field_ref: "species"
          type: CONTROL_INPUT
          label {
            text: "Tree species"
          }
          hint {
            text: "Scientific or common name of the harvested tree species."
          }
        }
      }
      components {
        control {
          field_ref: "log_id"
          type: CONTROL_INPUT
          label {
            text: "Log ID"
          }
          hint {
            text: "Barcode, hammer stamp, or physical tag number on the log."
          }
        }
      }
      components {
        control {
          field_ref: "diameter_cm"
          type: CONTROL_INPUT
          label {
            text: "Diameter (cm)"
          }
        }
      }
      components {
        control {
          field_ref: "length_m"
          type: CONTROL_INPUT
          label {
            text: "Log length (m)"
          }
        }
      }
      components {
        control {
          field_ref: "volume_m3"
          type: CONTROL_INPUT
          label {
            text: "Volume (m³)"
          }
        }
      }
      components {
        control {
          field_ref: "site_photo"
          type: CONTROL_UPLOAD
          label {
            text: "Site photo"
          }
          media_type: "image/*"
        }
      }
    }
  }
  status: STABLE
}
purpose_packs {
  id: "timber_traceability"
  title {
    values {
      key: "en"
      value: "Timber traceability"
    }
    values {
      key: "fr"
      value: "Traçabilité du bois"
    }
    values {
      key: "es"
      value: "Trazabilidad de la madera"
    }
    values {
      key: "vi"
      value: "Truy xuất nguồn gốc gỗ"
    }
    values {
      key: "sw"
      value: "Ufuatiliaji wa mbao"
    }
  }
  description {
    values {
      key: "en"
      value: "Record harvest compartments, felling permits, stump coordinates, tree species, log tags, and timber volumes for legal harvest and chain-of-custody verification."
    }
  }
  icon: "carpenter"
  form_template_ids: "timber_harvest_felling"
  export_profile_ids: "eudr_geojson"
  program_ids: "fsc"
  program_ids: "pefc"
  program_ids: "flegt"
  program_ids: "eudr"
  goals: "legal_timber"
  goals: "deforestation_free_supply_chains"
  pillar: MITIGATION
  status: STABLE
}
