# proto-file: shared/protos/library/library_bundle.proto
# proto-message: openforis.collectone.v1.library.LibraryBundle
#
# Global library seed: the `timber` vocabulary. Bootstraps the "All users"
# organization's library on a new deployment; entries omit organization_id,
# which the loader sets to the "All users" organization.
#
# The clients embed a Kotlin copy (GlobalLibrarySeedData.kt), and its
# GlobalLibrarySeedTest fails when the two differ. Template questions carry
# their concept links as `ground:concept` foreign attributes on their bindings.

concepts {
  id: "timber.species"
  version: 1
  label {
    values {
      key: "en"
      value: "Tree species"
    }
    values {
      key: "fr"
      value: "Espèce d'arbre"
    }
    values {
      key: "es"
      value: "Especie arbórea"
    }
    values {
      key: "vi"
      value: "Loài cây gỗ"
    }
    values {
      key: "sw"
      value: "Spishi ya mti"
    }
  }
  description {
    values {
      key: "en"
      value: "Scientific name of the tree species, matching the AGROVOC thesaurus where possible."
    }
  }
  keywords {
    values {
      key: "en"
      value: "species"
    }
  }
  keywords {
    values {
      key: "en"
      value: "timber species"
    }
  }
  keywords {
    values {
      key: "es"
      value: "especie"
    }
  }
  data_type: TYPE_STRING
  aggregation: NONE
  privacy_class: AGGREGATE_PUBLIC
  goals: "legal_timber"
  status: STABLE
}
