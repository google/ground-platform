# proto-file: shared/protos/library/library_bundle.proto
# proto-message: openforis.collectone.v1.library.LibraryBundle
#
# Global library seed: the `iplc` vocabulary. Bootstraps the "All users"
# organization's library on a new deployment; entries omit organization_id,
# which the loader sets to the "All users" organization.
#
# The clients embed a Kotlin copy (GlobalLibrarySeedData.kt), and its
# GlobalLibrarySeedTest fails when the two differ. Template questions carry
# their concept links as `ground:concept` foreign attributes on their bindings.

concepts {
  id: "iplc.community_type"
  version: 1
  label {
    values {
      key: "en"
      value: "Community type"
    }
    values {
      key: "fr"
      value: "Type de communauté"
    }
    values {
      key: "es"
      value: "Tipo de comunidad"
    }
    values {
      key: "vi"
      value: "Loại hình cộng đồng"
    }
    values {
      key: "sw"
      value: "Aina ya jamii"
    }
  }
  description {
    values {
      key: "en"
      value: "Whether the community identifies as Indigenous Peoples or a local community."
    }
  }
  data_type: TYPE_SELECT_ONE
  code_list {
    items {
      code: "indigenous_peoples"
      label {
        values {
          key: "en"
          value: "Indigenous Peoples"
        }
      }
    }
    items {
      code: "local_community"
      label {
        values {
          key: "en"
          value: "Local community"
        }
      }
    }
    items {
      code: "other"
      label {
        values {
          key: "en"
          value: "Other"
        }
      }
    }
  }
  aggregation: COUNT_BY_CODE
  privacy_class: ORG_ONLY
  goals: "iplc_rights_and_tenure"
  pillar: PROTECTION
  status: STABLE
}
