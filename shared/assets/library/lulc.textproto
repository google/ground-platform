              }
            }
          }
          strings {
            key: "disturbance_driver-5"
            value {
              value: "Storm, drought, or pest dieback"
              media {
                image_uri: "jr://images/disturbance_driver-wind_drought_pest.png"
              }
            }
          }
        }
      }
    }
    view {
      components {
        control {
          field_ref: "forest_change_class"
          type: CONTROL_SELECT_ONE
          label {
            text: "Forest change & transition class"
          }
          itemset {
            instance_id: "forest_change_class"
            value_ref: "name"
            label_ref: "label"
            nodeset_path: "/root/item"
          }
        }
      }
      components {
        control {
          field_ref: "baseline_land_use_ipcc"
          type: CONTROL_SELECT_ONE
          label {
            text: "Baseline IPCC land-use category"
          }
          itemset {
            instance_id: "baseline_land_use_ipcc"
            value_ref: "name"
            label_ref: "label"
            nodeset_path: "/root/item"
          }
        }
      }
      components {
        control {
          field_ref: "current_land_use_ipcc"
          type: CONTROL_SELECT_ONE
          label {
            text: "Current IPCC land-use category"
          }
          itemset {
            instance_id: "current_land_use_ipcc"
            value_ref: "name"
            label_ref: "label"
            nodeset_path: "/root/item"
          }
        }
      }
      components {
        control {
          field_ref: "forest_stratum"
          type: CONTROL_SELECT_ONE
          label {
            text: "Forest structure & stratum"
          }
          itemset {
            instance_id: "forest_stratum"
            value_ref: "name"
            label_ref: "jr:itext(itextId)"
            nodeset_path: "/root/item"
          }
        }
      }
      components {
        control {
          field_ref: "canopy_cover_pct"
          type: CONTROL_INPUT
          label {
            text: "Canopy cover (%)"
          }
        }
      }
      components {
        control {
          field_ref: "disturbance_year"
          type: CONTROL_INPUT
          label {
            text: "Disturbance or transition year"
          }
          hint {
            text: "Year of deforestation, degradation, or reforestation establishment."
          }
        }
      }
      components {
        control {
          field_ref: "disturbance_driver"
          type: CONTROL_SELECT_MULTIPLE
          label {
            text: "Observed disturbance or degradation"
          }
          itemset {
            instance_id: "disturbance_driver"
            value_ref: "name"
            label_ref: "jr:itext(itextId)"
            nodeset_path: "/root/item"
          }
        }
      }
      components {
        control {
          field_ref: "interpretation_confidence"
          type: CONTROL_SELECT_ONE
          label {
            text: "Interpretation confidence"
          }
          itemset {
            instance_id: "interpretation_confidence"
            value_ref: "name"
            label_ref: "label"
            nodeset_path: "/root/item"
          }
        }
      }
      components {
        control {
          field_ref: "observation_date"
          type: CONTROL_INPUT
          label {
            text: "Observation date"
          }
        }
      }
    }
  }
  status: STABLE
  version: 1
}
