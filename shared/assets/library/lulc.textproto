        field_path: "canopy_cover_pct"
        type: TYPE_DOUBLE
        foreign_attributes {
          namespace_uri: "http://openforis.org/collect-one/xforms"
          qualified_name: "collectone:concept"
          value: "lulc.canopy_cover_pct@1"
        }
      }
      bindings {
        field_path: "observation_date"
        type: TYPE_DATE
        foreign_attributes {
          namespace_uri: "http://openforis.org/collect-one/xforms"
          qualified_name: "collectone:concept"
          value: "lulc.observation_date@1"
        }
      }
      bindings {
        field_path: "site_photo"
        type: TYPE_BINARY
        foreign_attributes {
          namespace_uri: "http://openforis.org/collect-one/xforms"
          qualified_name: "collectone:concept"
          value: "core.site_photo@1"
        }
      }
    }
    view {
      components {
        control {
          field_ref: "land_cover_class"
          type: CONTROL_SELECT_ONE
          label {
            text: "Land cover class"
          }
          itemset {
            instance_id: "land_cover_class"
            value_ref: "name"
            label_ref: "label"
            nodeset_path: "/root/item"
          }
        }
      }
      components {
        control {
          field_ref: "land_use"
          type: CONTROL_SELECT_ONE
          label {
            text: "Land use"
          }
          itemset {
            instance_id: "land_use"
            value_ref: "name"
            label_ref: "label"
            nodeset_path: "/root/item"
          }
        }
      }
      components {
        control {
          field_ref: "crop_type"
          type: CONTROL_SELECT_ONE
          label {
            text: "Primary crop or tree commodity"
          }
          itemset {
            instance_id: "crop_type"
            value_ref: "name"
            label_ref: "label"
            nodeset_path: "/root/item"
          }
        }
      }
      components {
        control {
          field_ref: "shade_tree_tier"
          type: CONTROL_SELECT_ONE
          label {
            text: "Shade canopy structure"
          }
          itemset {
            instance_id: "shade_tree_tier"
            value_ref: "name"
            label_ref: "label"
            nodeset_path: "/root/item"
          }
        }
      }
      components {
        control {
          field_ref: "canopy_cover_pct"
          type: CONTROL_INPUT
          label {
            text: "Canopy cover (%)"
          }
        }
      }
      components {
        control {
          field_ref: "observation_date"
          type: CONTROL_INPUT
          label {
            text: "Observation date"
          }
        }
      }
      components {
        control {
          field_ref: "site_photo"
          type: CONTROL_UPLOAD
          label {
            text: "Site photo"
          }
          media_type: "image/*"
        }
      }
    }
  }
  status: STABLE
  version: 1
}
