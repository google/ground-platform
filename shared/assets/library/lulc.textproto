# proto-file: shared/protos/library/library_bundle.proto
# proto-message: openforis.collectone.v1.library.LibraryBundle
#
# Global library seed: the `lulc` vocabulary. Bootstraps the "All users"
# organization's library on a new deployment; entries omit organization_id,
# which the loader sets to the "All users" organization.
#
# The clients embed a Kotlin copy (GlobalLibrarySeedData.kt), and its
# GlobalLibrarySeedTest fails when the two differ. Template questions carry
# their concept links as `collectone:concept` foreign attributes on their bindings.

concepts {
  id: "lulc.land_cover_class"
  version: 1
  label {
    values {
      key: "en"
      value: "Land cover class"
    }
    values {
      key: "fr"
      value: "Classe de couverture terrestre"
    }
    values {
      key: "es"
      value: "Clase de cobertura terrestre"
    }
    values {
      key: "vi"
      value: "Lớp độ che phủ đất"
    }
    values {
      key: "sw"
      value: "Aina ya ufunikaji wa ardhi"
    }
  }
  description {
    values {
      key: "en"
      value: "Land cover category, following the FAO Global Forest Resources Assessment."
    }
  }
  keywords {
    values {
      key: "en"
      value: "land cover"
    }
  }
  keywords {
    values {
      key: "en"
      value: "vegetation"
    }
  }
  keywords {
    values {
      key: "es"
      value: "cobertura"
    }
  }
  data_type: TYPE_SELECT_ONE
  code_list {
    items {
      code: "forest"
      label {
        values {
          key: "en"
          value: "Forest"
        }
      }
    }
    items {
      code: "other_wooded_land"
      label {
        values {
          key: "en"
          value: "Other wooded land"
        }
      }
    }
    items {
      code: "other_land_with_tree_cover"
      label {
        values {
          key: "en"
          value: "Other land with tree cover"
        }
      }
    }
    items {
      code: "other_land"
      label {
        values {
          key: "en"
          value: "Other land"
        }
      }
    }
    items {
      code: "inland_water"
      label {
        values {
          key: "en"
          value: "Inland water bodies"
        }
      }
    }
  }
  aggregation: COUNT_BY_CODE
  privacy_class: AGGREGATE_PUBLIC
  goals: "deforestation_free_supply_chains"
  goals: "open_earth_data"
  pillar: MITIGATION
  status: STABLE
}
