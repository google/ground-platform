      key: "sw"
      value: "Uhakika wa tafsiri"
    }
  }
  description {
    values {
      key: "en"
      value: "Analyst confidence in the plot classification, used for ART-TREES Monte Carlo uncertainty assessment and flagging plots for field verification."
    }
  }
