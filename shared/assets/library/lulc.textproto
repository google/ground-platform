            key: "disturbance_driver-2"
            value {
              value: "Fire or burn scars"
              media {
                image_uri: "jr://images/disturbance_driver-fire_burn.png"
              }
            }
          }
          strings {
            key: "disturbance_driver-3"
            value {
              value: "Small-scale clearing or shifting cultivation"
              media {
                image_uri: "jr://images/disturbance_driver-agricultural_clearing.png"
              }
            }
          }
          strings {
            key: "disturbance_driver-4"
            value {
              value: "Livestock grazing"
              media {
                image_uri: "jr://images/disturbance_driver-grazing_browsing.png"
              }
            }
          }
          strings {
            key: "disturbance_driver-5"
            value {
              value: "Storm, drought, or pest dieback"
              media {
                image_uri: "jr://images/disturbance_driver-wind_drought_pest.png"
              }
            }
          }
        }
      }
    }
    view {
      components {
        control {
          field_ref: "forest_stratum"
          type: CONTROL_SELECT_ONE
          label {
            text: "Forest structure & stratum"
          }
          itemset {
            instance_id: "forest_stratum"
            value_ref: "name"
            label_ref: "jr:itext(itextId)"
            nodeset_path: "/root/item"
          }
        }
      }
      components {
        control {
          field_ref: "stand_age_years"
          type: CONTROL_INPUT
          label {
            text: "Stand age / regeneration years"
          }
          hint {
            text: "Stand or regeneration cohort age in years (for removal factors)."
          }
        }
      }
      components {
        control {
          field_ref: "species"
          type: CONTROL_INPUT
          label {
            text: "Tree species"
          }
          hint {
            text: "Dominant tree species scientific or common name (for wood density)."
          }
        }
      }
      components {
        control {
          field_ref: "diameter_cm"
          type: CONTROL_INPUT
          label {
            text: "Diameter (cm)"
          }
          hint {
            text: "Mean stem diameter at breast height (1.3 m) in centimeters."
          }
        }
      }
      components {
        control {
          field_ref: "tree_height_m"
          type: CONTROL_INPUT
          label {
            text: "Tree height (m)"
          }
          hint {
            text: "Dominant tree height in meters."
          }
        }
      }
      components {
        control {
          field_ref: "basal_area_m2_ha"
          type: CONTROL_INPUT
          label {
            text: "Basal area (m²/ha)"
          }
          hint {
            text: "Stand basal area in m²/ha."
          }
        }
      }
      components {
        control {
          field_ref: "canopy_cover_pct"
          type: CONTROL_INPUT
          label {
            text: "Canopy cover (%)"
          }
        }
      }
      components {
        control {
          field_ref: "deadwood_pool_level"
          type: CONTROL_SELECT_ONE
          label {
            text: "Dead wood & litter pool status"
          }
          itemset {
            instance_id: "deadwood_pool_level"
            value_ref: "name"
            label_ref: "label"
            nodeset_path: "/root/item"
          }
        }
      }
      components {
        control {
          field_ref: "peat_depth_cm"
          type: CONTROL_INPUT
          label {
            text: "Peat / organic soil depth (cm)"
          }
          hint {
            text: "Peat or organic soil horizon depth in cm (wetlands and mangroves)."
          }
        }
      }
      components {
        control {
          field_ref: "disturbance_driver"
          type: CONTROL_SELECT_MULTIPLE
          label {
            text: "Observed disturbance or degradation"
          }
          itemset {
            instance_id: "disturbance_driver"
            value_ref: "name"
            label_ref: "jr:itext(itextId)"
            nodeset_path: "/root/item"
          }
        }
      }
      components {
        control {
          field_ref: "collection_date"
          type: CONTROL_INPUT
          label {
            text: "Collection date"
          }
        }
      }
      components {
        control {
          field_ref: "site_photo"
          type: CONTROL_UPLOAD
          label {
            text: "Site photo"
          }
          media_type: "image/*"
        }
      }
    }
  }
  status: STABLE
  version: 1
}
purpose_packs {
  id: "lulc_training_data"
  title {
    values {
      key: "en"
      value: "Land cover & crop mapping"
    }
    values {
      key: "fr"
      value: "Cartographie de la couverture terrestre et des cultures"
    }
    values {
      key: "es"
      value: "Mapeo de cobertura terrestre y cultivos"
    }
    values {
      key: "vi"
      value: "Lập bản đồ độ che phủ đất và cây trồng"
    }
    values {
      key: "sw"
      value: "Uchoraji ramani wa ufunikaji wa ardhi na mazao"
    }
  }
  description {
    values {
      key: "en"
      value: "Collect ground-truth observations and visual imagery classifications of land cover, perennial crops, and shade trees to train and validate remote-sensing models."
    }
  }
  icon: "layers"
  form_template_ids: "lulc_ground_truth"
  program_ids: "fdap"
  program_ids: "fao_lccs"
  program_ids: "open_foris"
  program_ids: "fao_fra"
  goals: "deforestation_free_supply_chains"
  goals: "open_earth_data"
  pillar: MITIGATION
  status: STABLE
}
purpose_packs {
  id: "deforestation_activity_data"
  title {
    values {
      key: "en"
      value: "Deforestation & land-use change (Activity Data)"
    }
    values {
      key: "fr"
      value: "Déforestation et changement d'affectation des terres (données d'activité)"
    }
    values {
      key: "es"
      value: "Deforestación y cambio de uso del suelo (datos de actividad)"
    }
    values {
      key: "vi"
      value: "Mất rừng và thay đổi sử dụng đất (dữ liệu hoạt động)"
    }
    values {
      key: "sw"
      value: "Ukataji miti na mabadiliko ya matumizi ardhi (data ya shughuli)"
    }
  }
  description {
    values {
      key: "en"
      value: "Classify sample plots across multi-temporal satellite imagery and field checks to quantify deforestation, forest degradation, and reforestation areas with ART-TREES Monte Carlo uncertainty bounds."
    }
  }
  icon: "satellite_alt"
  form_template_ids: "deforestation_activity_assessment"
  export_profile_ids: "art_trees_activity_data_geojson"
  program_ids: "art_trees"
  goals: "forest_carbon_and_conservation"
  goals: "deforestation_free_supply_chains"
  pillar: MITIGATION
  status: STABLE
}
purpose_packs {
  id: "forest_carbon_inventory"
  title {
    values {
      key: "en"
      value: "Forest carbon & biomass inventory (Emission Factors)"
    }
    values {
      key: "fr"
      value: "Inventaire du carbone et de la biomasse forestière (facteurs d'émission)"
    }
    values {
      key: "es"
      value: "Inventario de carbono y biomasa forestal (factores de emisión)"
    }
    values {
      key: "vi"
      value: "Kiểm kê carbon và sinh khối rừng (hệ số phát thải)"
    }
    values {
      key: "sw"
      value: "Hesabu ya kaboni na tungamo hai ya msitu (viwango vya uzalishaji)"
    }
  }
  description {
    values {
      key: "en"
      value: "Measure ground sample plots for tree species, DBH, height, stand basal area, deadwood, and peat depth to calculate stratum-specific carbon stocks and ART-TREES emission and removal factors."
    }
  }
  icon: "forest"
  form_template_ids: "forest_carbon_inventory_plot"
  export_profile_ids: "art_trees_biomass_inventory_geojson"
  program_ids: "art_trees"
  goals: "forest_carbon_and_conservation"
  goals: "effective_protected_areas"
  pillar: MITIGATION
  status: STABLE
}
