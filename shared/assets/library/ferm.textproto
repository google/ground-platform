# proto-file: shared/protos/library/library_bundle.proto
# proto-message: groundplatform.v2.library.LibraryBundle
#
# Global library seed: the `ferm` vocabulary. Bootstraps the "All users"
# organization's library on a new deployment; entries omit organization_id,
# which the loader sets to the "All users" organization.
#
# The clients embed a Kotlin copy (GlobalLibrarySeedData.kt), and its
# GlobalLibrarySeedTest fails when the two differ. Template questions carry
# their concept links as `ground:concept` foreign attributes on their bindings.

concepts {
  id: "ferm.intervention_type"
  version: 1
  label {
    values {
      key: "en"
      value: "Restoration intervention"
    }
    values {
      key: "fr"
      value: "Type d'intervention"
    }
    values {
      key: "es"
      value: "Tipo de intervención"
    }
    values {
      key: "vi"
      value: "Loại hình can thiệp phục hồi"
    }
    values {
      key: "sw"
      value: "Aina ya uingiliaji wa urejeshaji"
    }
  }
  description {
    values {
      key: "en"
      value: "Main restoration approach used on the site."
    }
  }
  keywords {
    values {
      key: "en"
      value: "approach"
    }
  }
  keywords {
    values {
      key: "en"
      value: "method"
    }
  }
  keywords {
    values {
      key: "en"
      value: "restoration type"
    }
  }
  data_type: TYPE_SELECT_ONE
  code_list {
    items {
      code: "natural_regeneration"
      label {
        values {
          key: "en"
          value: "Natural regeneration"
        }
      }
    }
    items {
      code: "assisted_natural_regeneration"
      label {
        values {
          key: "en"
          value: "Assisted natural regeneration"
        }
      }
    }
    items {
      code: "tree_planting"
      label {
        values {
          key: "en"
          value: "Tree planting"
        }
      }
    }
    items {
      code: "agroforestry"
      label {
        values {
          key: "en"
          value: "Agroforestry"
        }
      }
    }
    items {
      code: "mangrove_restoration"
      label {
        values {
          key: "en"
          value: "Mangrove restoration"
        }
      }
    }
    items {
      code: "hydrological_rehabilitation"
      label {
        values {
          key: "en"
          value: "Hydrological or tidal rehabilitation"
        }
      }
    }
    items {
      code: "other"
      label {
        values {
          key: "en"
          value: "Other"
        }
      }
    }
  }
  aggregation: COUNT_BY_CODE
  privacy_class: AGGREGATE_PUBLIC
  goals: "ecosystem_restoration"
  pillar: MITIGATION
  status: STABLE
}
