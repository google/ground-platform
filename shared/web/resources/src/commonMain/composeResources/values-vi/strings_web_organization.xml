  <!-- Section subtitles. %1$s: organization name. -->
  <string name="org_details_subtitle_manager">Cách %1$s hiển thị với thành viên và trong danh mục. Chỉ Người quản lý mới có thể thay đổi các thông tin này.</string>
  <string name="org_details_subtitle_member">Cách %1$s hiển thị với thành viên và trong danh mục. Hãy yêu cầu Người quản lý thay đổi các thông tin này.</string>
  <string name="org_surveys_subtitle_manager">Các khảo sát được thực hiện thay mặt %1$s. Là Người quản lý, bạn có thể chỉnh sửa mọi khảo sát, quản lý việc chia sẻ và xuất dữ liệu của khảo sát.</string>
  <string name="org_surveys_subtitle_member">Các khảo sát được thực hiện thay mặt %1$s. Mở một khảo sát để xem bạn có thể làm gì trong đó.</string>
  <string name="org_members_subtitle_admins">Quản trị viên nền tảng quản lý hình ảnh, mục đích, mẫu và khái niệm từ điển dùng chung.</string>
  <string name="org_members_subtitle">Những người liên kết với %1$s. Người quản lý điều hành tổ chức và tất cả khảo sát của tổ chức; Thành viên có thể tạo khảo sát trong tổ chức.</string>
  <string name="org_imagery_subtitle_admins">Các lớp hình ảnh bản đồ nền tùy chỉnh dành cho tất cả người dùng Collect One trong mọi khảo sát, có trong hộp thoại lớp bản đồ nền trên di động và web.</string>
  <string name="org_imagery_subtitle_manager">Các lớp hình ảnh bản đồ nền tùy chỉnh có trong hộp thoại lớp bản đồ nền trên di động và web cho các khảo sát thuộc %1$s.</string>
  <string name="org_imagery_subtitle_member">Các lớp hình ảnh bản đồ nền tùy chỉnh được cấu hình cho các khảo sát thuộc %1$s. Hãy yêu cầu Người quản lý thêm hoặc thay đổi nguồn hình ảnh.</string>
  <string name="org_purposes_subtitle_admins">Các lựa chọn mà mọi tổ chức thấy cho câu hỏi "Dữ liệu này sẽ được dùng để làm gì?" khi tạo khảo sát. Mỗi mục đích sẽ thêm các mẫu của nó vào khảo sát mới.</string>
  <string name="org_purposes_subtitle">Các lựa chọn cho câu hỏi "Dữ liệu này sẽ được dùng để làm gì?" khi tạo khảo sát trong %1$s: mục đích riêng của tổ chức trước, sau đó là mục đích chung.</string>
  <string name="org_dictionary_subtitle_admins">Khái niệm chung: các trường chuẩn liên kết câu hỏi trong biểu mẫu với một ý nghĩa dùng chung, để câu trả lời có thể được so sánh và cộng dồn giữa các khảo sát và ngôn ngữ.</string>
  <string name="org_dictionary_subtitle">Các khái niệm dành cho khảo sát trong %1$s: các trường chuẩn mang lại cho câu hỏi trong biểu mẫu một ý nghĩa dùng chung, để câu trả lời có thể được so sánh và cộng dồn.</string>
  <string name="org_templates_subtitle_admins">Các mẫu biểu mẫu chung mà mọi tổ chức có thể thêm vào khảo sát của mình.</string>
  <string name="org_templates_subtitle">Các mẫu biểu mẫu dành cho khảo sát trong %1$s: mẫu riêng của tổ chức trước, sau đó là mẫu chung.</string>
  <string name="org_cost_controls_title_global">Kiểm soát chi phí &amp; hạn mức chung</string>
  <string name="org_cost_controls_subtitle_global">Giới hạn hạn mức mặc định và trọng số chi phí đơn vị áp dụng cho các tổ chức và khảo sát trên toàn nền tảng.</string>
  <string name="org_cost_controls_subtitle_manager">Mức trần ngân sách và giới hạn hạn mức cho %1$s. Cấu hình cấp độ đặt sẵn hoặc giới hạn tài nguyên chi tiết.</string>
  <string name="org_cost_controls_subtitle_member">Mức trần ngân sách và giới hạn hạn mức cho %1$s. Hãy yêu cầu người quản lý tổ chức điều chỉnh các giới hạn này.</string>
  <string name="org_cost_tracking_title">Theo dõi chi phí nền tảng</string>
  <string name="org_cost_tracking_subtitle">Hạch toán chi phí trực tiếp, tổng hợp mức sử dụng tài nguyên và phân tích tuân thủ ngân sách theo tổ chức, khảo sát và người dùng.</string>

