  <string name="org_surveys_subtitle_manager">Encuestas realizadas en nombre de %1$s. Como administrador, puede editar cada una de ellas, gestionar con quién se comparten y exportar sus datos.</string>
  <string name="org_surveys_subtitle_member">Encuestas realizadas en nombre de %1$s. Abra una para ver lo que puede hacer en ella.</string>
  <string name="org_members_subtitle_admins">Administradores de la plataforma que gestionan las imágenes, los propósitos, las plantillas y los conceptos del diccionario globales.</string>
  <string name="org_members_subtitle">Personas afiliadas a %1$s. Los administradores dirigen la organización y todas sus encuestas; los miembros pueden crear encuestas en ella.</string>
  <string name="org_imagery_subtitle_admins">Capas de imágenes personalizadas del mapa base disponibles para todos los usuarios de Collect One en todas las encuestas, desde el cuadro de diálogo de capas del mapa base en dispositivos móviles y en la web.</string>
  <string name="org_imagery_subtitle_manager">Capas de imágenes personalizadas del mapa base disponibles en el cuadro de diálogo de capas del mapa base, en dispositivos móviles y en la web, para las encuestas de %1$s.</string>
  <string name="org_imagery_subtitle_member">Capas de imágenes personalizadas del mapa base configuradas para las encuestas de %1$s. Pida a un administrador que agregue o cambie fuentes de imágenes.</string>
  <string name="org_purposes_subtitle_admins">Opciones que todas las organizaciones ven para "¿Para qué se usarán estos datos?" al crear una encuesta. Cada propósito agrega sus plantillas a la nueva encuesta.</string>
  <string name="org_purposes_subtitle">Opciones que se ofrecen para "¿Para qué se usarán estos datos?" al crear una encuesta en %1$s: primero sus propios propósitos y luego los globales.</string>
  <string name="org_dictionary_subtitle_admins">Conceptos globales: campos estándar que vinculan las preguntas de los formularios a un significado compartido, para que las respuestas se puedan comparar y sumar entre encuestas e idiomas.</string>
  <string name="org_dictionary_subtitle">Conceptos disponibles para las encuestas de %1$s: campos estándar que dan a las preguntas de los formularios un significado compartido, para que las respuestas se puedan comparar y sumar.</string>
  <string name="org_templates_subtitle_admins">Plantillas de formulario globales que cualquier organización puede agregar a sus encuestas.</string>
  <string name="org_templates_subtitle">Plantillas de formulario disponibles para las encuestas de %1$s: primero sus propias plantillas y luego las globales.</string>
  <string name="org_cost_controls_title_global">Control de costos y cuotas globales</string>
