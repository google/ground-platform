  <!-- Section subtitles. %1$s: organization name. -->
  <string name="org_details_subtitle_manager">Jinsi %1$s linavyoonekana kwa wanachama na kwenye saraka. Wasimamizi pekee ndio wanaweza kubadilisha haya.</string>
  <string name="org_details_subtitle_member">Jinsi %1$s linavyoonekana kwa wanachama na kwenye saraka. Muombe Msimamizi abadilishe haya.</string>
  <string name="org_surveys_subtitle_manager">Tafiti zinazoendeshwa kwa niaba ya %1$s. Kama Msimamizi, unaweza kuhariri kila moja, kusimamia ushiriki wake, na kuhamisha data yake.</string>
  <string name="org_surveys_subtitle_member">Tafiti zinazoendeshwa kwa niaba ya %1$s. Fungua mojawapo kuona unachoweza kufanya ndani yake.</string>
  <string name="org_members_subtitle_admins">Wasimamizi wakuu wa jukwaa wanaosimamia taswira, madhumuni, violezo, na dhana za kamusi za kimataifa.</string>
  <string name="org_members_subtitle">Watu wanaohusishwa na %1$s. Wasimamizi huendesha shirika na tafiti zake zote; Wanachama wanaweza kuunda tafiti ndani yake.</string>
  <string name="org_imagery_subtitle_admins">Matabaka maalum ya taswira ya ramani ya msingi yanayopatikana kwa watumiaji wote wa Collect One katika kila utafiti, kwenye kidirisha cha matabaka ya ramani ya msingi kwenye simu na wavuti.</string>
  <string name="org_imagery_subtitle_manager">Matabaka maalum ya taswira ya ramani ya msingi yanayopatikana kwenye kidirisha cha matabaka ya ramani ya msingi kwenye simu na wavuti kwa tafiti za %1$s.</string>
  <string name="org_imagery_subtitle_member">Matabaka maalum ya taswira ya ramani ya msingi yaliyowekwa kwa tafiti za %1$s. Muombe Msimamizi aongeze au abadilishe vyanzo vya taswira.</string>
  <string name="org_purposes_subtitle_admins">Chaguo ambazo kila shirika huona kwa swali "Data hii itatumika kwa nini?" wakati wa kuunda utafiti. Kila madhumuni huongeza violezo vyake kwenye utafiti mpya.</string>
  <string name="org_purposes_subtitle">Chaguo zinazotolewa kwa swali "Data hii itatumika kwa nini?" wakati wa kuunda utafiti katika %1$s: madhumuni yake yenyewe kwanza, kisha ya kimataifa.</string>
  <string name="org_dictionary_subtitle_admins">Dhana za kimataifa: sehemu sanifu zinazounganisha maswali ya fomu na maana moja ya pamoja, ili majibu yaweze kulinganishwa na kujumlishwa katika tafiti na lugha mbalimbali.</string>
  <string name="org_dictionary_subtitle">Dhana zinazopatikana kwa tafiti za %1$s: sehemu sanifu zinazoyapa maswali ya fomu maana moja ya pamoja, ili majibu yaweze kulinganishwa na kujumlishwa.</string>
  <string name="org_templates_subtitle_admins">Violezo vya fomu vya kimataifa ambavyo kila shirika linaweza kuongeza kwenye tafiti zake.</string>
  <string name="org_templates_subtitle">Violezo vya fomu vinavyopatikana kwa tafiti za %1$s: violezo vyake yenyewe kwanza, kisha vya kimataifa.</string>
  <string name="org_cost_controls_title_global">Udhibiti wa gharama na vikomo vya kimataifa</string>
  <string name="org_cost_controls_subtitle_global">Vikomo chaguomsingi vya jukwaa zima na uzito wa gharama kwa kila kipimo vinavyotumika kwa mashirika na tafiti.</string>
  <string name="org_cost_controls_subtitle_manager">Vikomo vya bajeti na vikomo vya matumizi kwa %1$s. Weka viwango vilivyowekwa awali au vikomo mahususi vya rasilimali.</string>
  <string name="org_cost_controls_subtitle_member">Vikomo vya bajeti na vikomo vya matumizi kwa %1$s. Muombe msimamizi wa shirika arekebishe vikomo hivi.</string>
  <string name="org_cost_tracking_title">Ufuatiliaji wa gharama za jukwaa</string>
  <string name="org_cost_tracking_subtitle">Uhasibu wa gharama wa moja kwa moja, muhtasari wa matumizi ya rasilimali, na uchanganuzi wa uzingatiaji wa bajeti katika mashirika, tafiti, na watumiaji.</string>

